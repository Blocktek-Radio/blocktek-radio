{
  "name": "@blocktek/audiotrust-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "build": "tsc -p tsconfig.json && cp -R src/db/migrations dist/db/migrations",
    "migrate": "node --env-file-if-exists=.env.local --import tsx src/db/migrate.ts",
    "platform-key:dev": "node --env-file-if-exists=.env.local --import tsx src/cli/create-platform-dev-key.ts",
    "test": "node --env-file-if-exists=.env.local --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "9.2.1",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.7.3"
  }
}
