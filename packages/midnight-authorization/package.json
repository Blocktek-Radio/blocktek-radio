{
  "name": "@blocktek/midnight-authorization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AudioTrust Publisher Authorization Compact contract and local demo",
  "scripts": {
    "compile": "compact compile contract/src/audio-trust-publisher-authorization.compact artifacts/contract",
    "compile:check": "compact compile --skip-zk contract/src/audio-trust-publisher-authorization.compact artifacts/contract-check",
    "test": "node --test test/*.test.mjs",
    "test:runtime": "node --test test/*.test.mjs",
    "test:privacy": "node --test --test-name-pattern='privacy' test/*.test.mjs",
    "test:governance": "node --test --test-name-pattern='issuer|rotation|suspension|revocation' test/*.test.mjs",
    "test:integration": "pnpm compile:check && vitest run --config vitest.integration.config.mjs",
    "devnet:up": "podman compose up -d --wait",
    "devnet:status": "podman compose ps",
    "devnet:logs": "podman compose logs --tail=200",
    "devnet:down": "podman compose down",
    "devnet:reset": "podman compose down --volumes --remove-orphans",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.5",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/testkit-js": "5.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@noble/curves": "1.9.7",
    "pino": "9.9.0",
    "pino-pretty": "13.1.1",
    "rxjs": "7.8.2",
    "vitest": "5.0.4",
    "ws": "8.18.3"
  }
}
